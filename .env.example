# انسخ هذا الملف إلى .env محليا، وعلى Render أضف القيم من لوحة Environment.
# لا ترفع .env إلى GitHub.

PORT=3000

# خادم SMTP (مثال: مزوّد البريد الذي تستخدمه)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true للمنفذ 465، وfalse للمنفذ 587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# من يرسل الرسالة (يجب أن يقبله مزوّد SMTP) ومن يستلمها
MAIL_FROM="وين نروح؟ <no-reply@example.com>"
MAIL_TO=you@example.com
